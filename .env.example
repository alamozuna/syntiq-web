# Copy to .env.local for local development, and set the same keys in Vercel → Settings → Environment Variables.

# Resend API key (https://resend.com/api-keys). Without it the contact form returns an error
# instead of pretending the message was sent.
RESEND_API_KEY=

# Sender. Must belong to a domain verified in Resend. "onboarding@resend.dev" only works in
# test mode and only delivers to the Resend account owner.
CONTACT_FROM="SyntIQ Web <web@syntiqgroup.com>"

# Inbox that receives contact-form submissions.
CONTACT_EMAIL=syntiqgroup@gmail.com
